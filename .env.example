# =============================================================================
# 퍼뜩 .env 예시 — 이 파일을 복사해서 .env 를 만드세요
# =============================================================================
#
# 왕초보 안내
# 1) 복사:  이 파일을 .env 로 저장한 뒤, replace-with- 자리를 실제 값으로 바꿉니다.
# 2) .env 는 GitHub에 올리면 안 됩니다. 채팅에도 붙이지 마세요.
# 3) 등호(=) 양옆에 공백을 넣지 마세요.  맞음: KEY=값   틀림: KEY = 값
# 4) VITE_ 로 시작하는 것만 화면(브라우저)에 나갑니다. 나머지는 이 컴퓨터/서버 전용.
# 5) 빈 줄과 # 으로 시작하는 줄은 설명입니다. 프로그램은 읽지 않습니다.
#
# 값을 어디서 복사하나요?
# - Supabase: 대시보드 → Project Settings → API
# - Cloudflare: dash.cloudflare.com → My Profile → API Tokens
# - Resend: resend.com → API Keys
#

# -----------------------------------------------------------------------------
# 1) 화면용 (브라우저에 나감)  — 필수
#    회원/운영자 화면이 어느 데이터베이스에 붙을지 알려 줍니다.
#    여기는 "공개 가능 키"만. 비밀 키(service_role)는 절대 넣지 마세요.
# -----------------------------------------------------------------------------
VITE_PUTDUK_SUPABASE_URL=https://gaugwamwceqdnqdqrxqg.supabase.co
VITE_PUTDUK_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# -----------------------------------------------------------------------------
# 2) 데이터베이스 (Supabase)  — 필수
#    스크립트·서버가 같은 프로젝트를 찾습니다.
#    URL / 프로젝트 코드는 화면용과 같아야 합니다.
#
#    공개 키 두 종류가 있습니다. 둘 다 필요합니다.
#    - PUBLISHABLE_KEY : 새로 나온 sb_publishable_ 로 시작하는 키
#    - ANON_KEY        : eyJ 로 시작하는 예전 공개 JWT (anon)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://gaugwamwceqdnqdqrxqg.supabase.co
SUPABASE_PROJECT_REF=gaugwamwceqdnqdqrxqg
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_ANON_KEY=replace-with-anon-key

# 관리자 열쇠. 화면·GitHub·Cloudflare Pages에 넣으면 안 됩니다.
# 대시보드 → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# CLI/배포 자동화용 개인 토큰. sbp_ 로 시작합니다. 없어도 로컬 화면은 켜집니다.
# SUPABASE_ACCESS_TOKEN=replace-with-supabase-access-token

# -----------------------------------------------------------------------------
# 3) 로컬에서 열 주소  — 필수
#    회원 화면:  http://127.0.0.1:4173
#    운영 화면:  http://127.0.0.1:4174
#    콤마로 여러 주소를 이으면 됩니다. 띄어쓰기 없이.
# -----------------------------------------------------------------------------
PUTDUK_SITE_URL=http://127.0.0.1:4173
PUTDUK_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:4174,http://localhost:4174

# -----------------------------------------------------------------------------
# 4) 운영자 로그인  — 필수
#    운영 화면(4174)에 들어가는 계정입니다. 회원 체험 계정과 섞지 마세요.
# -----------------------------------------------------------------------------
PUTDUK_ADMIN_EMAIL=replace-with-admin-email
PUTDUK_ADMIN_PASSWORD=replace-with-admin-password

# -----------------------------------------------------------------------------
# 5) 체험 회원 계정  — 로컬 테스트용
#    지원금 체험을 돌릴 때 씁니다. 운영자 계정과 다릅니다.
# -----------------------------------------------------------------------------
# PUTDUK_TRIAL_EMAIL=crew.trial@putduk.local
# PUTDUK_TRIAL_PASSWORD=replace-with-trial-password
# PUTDUK_TRIAL_PIN=147258

# -----------------------------------------------------------------------------
# 6) 입금·출금 API 스위치  — 기본은 끄기
#    true 는 KYC/결제 연결 이후에만. 켜면 회원 입금·일반 출금이 서버에서 열립니다.
#    비우거나 false 면 서버가 거절합니다.
#    예외: 체험 수당 3천 원 출금은 운영자가 따로 처리합니다.
# -----------------------------------------------------------------------------
PUTDUK_ENABLE_FINANCE_API=false

# -----------------------------------------------------------------------------
# 7) 인증 메일 (Resend SMTP)  — 가입 메일을 보낼 때
#    키를 지어내지 마세요. resend.com 에서 복사해 붙입니다.
#    SMTP_PASS 는 RESEND_API_KEY 와 같은 값을 넣으면 됩니다.
# -----------------------------------------------------------------------------
# RESEND_API_KEY=replace-with-resend-api-key
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=replace-with-resend-api-key
# SMTP_ADMIN_EMAIL=noreply@example.com
# SMTP_SENDER_NAME=퍼뜩

# -----------------------------------------------------------------------------
# 8) 배포 도구 (Cloudflare)  — 사이트 올릴 때만
#    로컬에서 화면만 볼 때는 없어도 됩니다.
# -----------------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
# CLOUDFLARE_PAGES_PROJECT=putduk-data-platform
